{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "mpris",
        "network",
        "cpu",
        "memory",
        "battery",
        "clock"
    ],
    "hyprland/workspaces": {
        "format": " {id} ",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },
    "hyprland/submap": {
        "format": "  {} ",
        "max-length": 16,
        "tooltip": false
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 60,
        "separate-outputs": true,
        "tooltip": false
    },
    "mpris": {
        "format": "{status_icon} {artist} — {title}",
        "format-paused": " {artist} — {title}",
        "format-stopped": "",
        "status-icons": {
            "playing": ""
        },
        "max-length": 40,
        "tooltip": false
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  none",
        "max-length": 20,
        "tooltip-format": "{ipaddr} via {gwaddr}\n{bandwidthDownBytes} ↓ {bandwidthUpBytes} ↑"
    },
    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "tooltip": false
    },
    "memory": {
        "format": "  {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo}"
    },
    "clock": {
        "format": " {:%H:%M:%S}",
        "interval": 1,
        "tooltip-format": "{:%A, %d %B %Y}"
    }
}
